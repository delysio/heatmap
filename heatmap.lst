0 REM --- PROGRAM HEAT MAP
1 REM 
2 DIM MAP(31,31):DIM VALUE(13)
3 REM
4 REM --- POPULATE ARRAY WITH DATA
5 GOSUB 700
6 REM --- POPULATE ARRAY WITH COLORS
7 GOSUB 1300
8 REM
10 GRAPHICS 11
11 YREAL=0: XCENTER=20: YCENTER=20
20 FOR X=0 TO 30
30 FOR Y=0 TO 30
40 C=MAP(X,Y)
41 COLOR DCOLORS(C)
50 FOR YADD=0 TO 3
51 PLOT XCENTER+X,YCENTER+YREAL+YADD
52 NEXT YADD
53 YREAL=YREAL+4
60 NEXT Y
61 YREAL=0
70 NEXT X
100 GOTO 100
697 REM
698 REM --- PROCEDURE READ DATA
699 REM
700 PRINT "READING DATA. PLEASE WAIT..."
701 RESTORE 1000
800 FOR X = 0 TO 30
801 FOR Y = 0 TO 30
802 READ VALUE
804 MAP(X,Y) = VALUE
805 NEXT Y
806 NEXT X
807 PRINT "DATA LOADED. PRESS KEY."
808 IF PEEK(764)=255 THEN 808
809 RETURN
997 REM
